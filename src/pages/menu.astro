---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const beers = await getCollection('menu');
beers.sort((a, b) => a.data.order - b.data.order || a.data.name.localeCompare(b.data.name));
---

<Layout title="Menu">
  <!-- Hero Banner -->
  <div class="bg-[#2D5016] py-16 px-4 text-center">
    <h1 class="text-[#FCC200] text-5xl font-extrabold mb-3">On Tap</h1>
    <p class="text-yellow-200/80 text-lg max-w-xl mx-auto">Craft beers curated from local California breweries and beyond.</p>
  </div>

  <!-- Beer Grid -->
  <section class="max-w-7xl mx-auto px-4 py-16">
    {beers.length === 0 ? (
      <p class="text-center text-gray-500">No beers on the menu right now. Check back soon!</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
        {beers.map(beer => (
          <div class:list={[
            "relative rounded-xl shadow-sm transition-all duration-200 overflow-hidden",
            beer.data.available
              ? "bg-white border border-gray-100 hover:shadow-md hover:border-[#FCC200]"
              : "bg-gray-50 border-2 border-dashed border-gray-300 shadow-none",
          ]}>
            <!-- Corner ribbon, decorative: the badge below carries the meaning -->
            {!beer.data.available && (
              <div class="absolute top-0 right-0 w-24 h-24 overflow-hidden pointer-events-none" aria-hidden="true">
                <span class="absolute top-4 -right-9 w-32 rotate-45 bg-[#8B2E1F] text-white text-[10px] font-bold uppercase tracking-widest text-center py-1">
                  Tapped
                </span>
              </div>
            )}

            <!-- Color bar -->
            <div class:list={["h-2", beer.data.available ? "bg-gradient-to-r from-[#2D5016] to-[#FCC200]" : "bg-gray-300"]}></div>
            <div class="p-6">
              <h2 class:list={["text-xl font-bold mb-1 pr-14", beer.data.available ? "text-[#2D5016]" : "text-gray-500"]}>{beer.data.name}</h2>
              <div class="flex flex-wrap gap-2 mb-3">
                <span class:list={[
                  "inline-block text-xs font-semibold px-3 py-1 rounded-full",
                  beer.data.available ? "bg-[#2D5016] text-[#FCC200]" : "bg-gray-200 text-gray-500",
                ]}>{beer.data.style}</span>
                {!beer.data.available && (
                  <span class="inline-block text-xs font-semibold bg-[#8B2E1F]/10 text-[#8B2E1F] px-3 py-1 rounded-full">Tapped Out</span>
                )}
              </div>

              <div class:list={[
                "flex items-center justify-between text-sm mb-3 rounded-lg px-3 py-2",
                beer.data.available ? "text-gray-600 bg-gray-50" : "text-gray-400 bg-gray-100/70",
              ]}>
                <span>
                  <span class="font-medium">{beer.data.size}</span>
                </span>
                <span>
                  <span class="font-medium">{beer.data.abv}%</span> ABV
                </span>
              </div>

              <div class="flex items-center justify-between">
                <span class:list={[
                  "text-2xl font-extrabold",
                  beer.data.available ? "text-[#2D5016]" : "text-gray-400 line-through decoration-2 decoration-gray-400",
                ]}>${beer.data.price}</span>
                <span class:list={[
                  "text-xs px-2 py-1 rounded-full",
                  beer.data.available ? "text-gray-400 bg-gray-100" : "text-[#8B2E1F] bg-[#8B2E1F]/10 font-medium",
                ]}>{beer.data.available ? "per pour" : "Back soon"}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}
  </section>

  <!-- Note -->
  <div class="max-w-7xl mx-auto px-4 pb-16 text-center">
    <p class="text-gray-500 text-sm">Tap list rotates seasonally. Ask your bartender about today's specials.</p>
    <p class="text-gray-400 text-xs mt-1">Must be 21+ to purchase alcohol. Please drink responsibly.</p>
  </div>
</Layout>
